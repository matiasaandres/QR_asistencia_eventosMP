rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function platformAdmin() {
      return signedIn()
        && request.auth.token.email == 'matias.andres.mh@gmail.com';
    }

    function organizationAdmin(organizationId) {
      return platformAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role == 'admin');
    }

    match /organizations/{organizationId} {
      function organizationActive() {
        return exists(/databases/$(database)/documents/organizations/$(organizationId))
          && get(/databases/$(database)/documents/organizations/$(organizationId)).data.status == 'active';
      }

      function isMember() {
        return platformAdmin() || (signedIn()
          && organizationActive()
          && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.status == 'active');
      }

      function roleIs(role) {
        return isMember()
          && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role == role;
      }

      function isAdmin() {
        return platformAdmin() || roleIs('admin');
      }

      function canOperate() {
        return isAdmin() || roleIs('operator');
      }

      function validOrganization(data) {
        return data.keys().hasOnly([
            'id', 'slug', 'name', 'ownerUid', 'memberUids', 'plan', 'status',
            'createdAt', 'updatedAt', 'logoUrl', 'primaryColor', 'contactEmail'
          ])
          && data.id == organizationId
          && data.slug == organizationId
          && data.name is string
          && data.name.size() >= 2
          && data.name.size() <= 100
          && data.logoUrl is string
          && data.logoUrl.size() <= 700000
          && data.primaryColor is string
          && data.primaryColor.matches('^#[0-9A-Fa-f]{6}$')
          && data.ownerUid is string
          && data.memberUids is list
          && data.memberUids.size() >= 1
          && data.memberUids.size() <= 100
          && data.ownerUid in data.memberUids
          && (!('contactEmail' in data) || data.contactEmail is string)
          && data.plan in ['pilot', 'event', 'monthly', 'annual']
          && data.status in ['active', 'suspended'];
      }

      allow list, get: if platformAdmin() || (signedIn() && request.auth.uid in resource.data.memberUids);
      allow create: if platformAdmin()
        && validOrganization(request.resource.data)
        && request.resource.data.memberUids.size() == 1;
      allow update: if validOrganization(request.resource.data) && (
        (platformAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'contactEmail', 'plan', 'status', 'logoUrl', 'primaryColor', 'ownerUid', 'memberUids', 'updatedAt']))
        ||
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'logoUrl', 'primaryColor', 'memberUids', 'updatedAt']))
        || (signedIn()
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
          && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.invitationCode is string
          && get(/databases/$(database)/documents/organizationInvitations/$(getAfter(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.invitationCode)).data.organizationId == organizationId
          && get(/databases/$(database)/documents/organizationInvitations/$(getAfter(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.invitationCode)).data.email == request.auth.token.email)
      );
      allow delete: if false;

      match /members/{userId} {
        function validMember(data) {
          return data.keys().hasOnly([
              'userId', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt',
              'invitationCode'
            ])
            && data.userId == userId
            && data.email is string
            && data.role in ['admin', 'operator', 'viewer']
            && data.status in ['active', 'disabled'];
        }

        allow read: if isMember();
        allow create: if validMember(request.resource.data) && (
          platformAdmin()
          ||
          isAdmin()
          || (
            signedIn()
            && userId == request.auth.uid
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)).data.ownerUid == request.auth.uid
          )
          || (
            signedIn()
            && userId == request.auth.uid
            && request.resource.data.invitationCode is string
            && get(/databases/$(database)/documents/organizationInvitations/$(request.resource.data.invitationCode)).data.organizationId == organizationId
            && get(/databases/$(database)/documents/organizationInvitations/$(request.resource.data.invitationCode)).data.email == request.auth.token.email
            && get(/databases/$(database)/documents/organizationInvitations/$(request.resource.data.invitationCode)).data.role == request.resource.data.role
            && get(/databases/$(database)/documents/organizationInvitations/$(request.resource.data.invitationCode)).data.status == 'active'
            && get(/databases/$(database)/documents/organizationInvitations/$(request.resource.data.invitationCode)).data.expiresAt > request.time
          )
        );
        allow update: if (platformAdmin() || isAdmin())
          && validMember(request.resource.data)
          && (userId != request.auth.uid || (request.resource.data.role == 'admin' && request.resource.data.status == 'active'))
          && (userId != get(/databases/$(database)/documents/organizations/$(organizationId)).data.ownerUid
            || (request.resource.data.role == 'admin' && request.resource.data.status == 'active'));
        allow delete: if (platformAdmin() || isAdmin())
          && userId != request.auth.uid
          && userId != get(/databases/$(database)/documents/organizations/$(organizationId)).data.ownerUid;
      }

      match /events/{eventId} {
        function validEvent(data) {
          return data.keys().hasOnly([
              'id', 'name', 'institution', 'date', 'defaultCapacity', 'doors',
              'status', 'startsAt', 'endsAt', 'archived', 'studentsInitialized', 'initializedAt', 'createdAt', 'updatedAt'
            ])
            && data.id == eventId
            && data.name is string
            && data.name.size() >= 2
            && data.name.size() <= 120
            && data.institution is string
            && data.date is string
            && data.defaultCapacity is int
            && data.defaultCapacity >= 1
            && data.defaultCapacity <= 50
            && data.doors is list
            && data.doors.size() >= 1
            && data.doors.size() <= 20
            && data.status in ['draft', 'open', 'paused', 'closed']
            && data.startsAt is string
            && data.endsAt is string
            && data.archived is bool
            && data.studentsInitialized == true;
        }

        function eventWillBeOpen() {
          return canOperate()
            && existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId))
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)).data.archived == false
            && (!('status' in getAfter(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)).data)
              || getAfter(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)).data.status == 'open');
        }

        allow read: if isMember();
        allow create: if isAdmin() && validEvent(request.resource.data);
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'institution', 'date', 'defaultCapacity', 'doors', 'archived',
              'status', 'startsAt', 'endsAt', 'studentsInitialized', 'initializedAt', 'createdAt', 'updatedAt'
            ])
          && validEvent(request.resource.data);
        allow delete: if false;

        match /families/{familyId} {
          function validFamily(data) {
            return data.keys().hasOnly([
                'id', 'maxCapacity', 'enteredCount', 'status', 'members',
                'insideCount', 'lastEntryAt', 'lastMovementAt', 'extraGuest', 'createdAt', 'updatedAt'
              ])
              && data.id == familyId
              && data.maxCapacity is int
              && data.maxCapacity >= 1
              && data.maxCapacity <= 50
              && data.enteredCount is int
              && data.enteredCount >= 0
              && data.enteredCount <= data.maxCapacity + 1
              && data.insideCount is int
              && data.insideCount >= 0
              && data.insideCount <= data.enteredCount
              && data.members is list
              && data.members.size() >= 1
              && data.members.size() <= 100;
          }

          allow read: if isMember();
          allow create: if isAdmin() && validFamily(request.resource.data);
          allow update: if validFamily(request.resource.data) && (
            isAdmin()
            || (eventWillBeOpen() && canOperate()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['enteredCount', 'insideCount', 'status', 'lastEntryAt', 'lastMovementAt', 'extraGuest'])
              && (
                (request.resource.data.enteredCount >= resource.data.enteredCount
                  && request.resource.data.enteredCount <= resource.data.maxCapacity
                  && request.resource.data.insideCount >= resource.data.insideCount)
                || (request.resource.data.enteredCount == resource.data.enteredCount
                  && request.resource.data.insideCount < resource.data.insideCount)
                || (resource.data.enteredCount == resource.data.maxCapacity + 1
                  && request.resource.data.enteredCount == resource.data.enteredCount
                  && request.resource.data.insideCount > resource.data.insideCount
                  && resource.data.extraGuest is map)
                || (resource.data.enteredCount == resource.data.maxCapacity
                  && !('extraGuest' in resource.data)
                  && request.resource.data.enteredCount == resource.data.maxCapacity + 1
                  && request.resource.data.status == 'CUPO_EXTRA'
                  && request.resource.data.extraGuest is map)
              ))
          );
          allow delete: if isAdmin();
        }

        match /students/{studentId} {
          allow read: if isMember();
          allow create: if isAdmin()
            && request.resource.data.enteredCount is int
            && request.resource.data.insideCount is int
            && request.resource.data.maxCapacity is int
            && request.resource.data.enteredCount >= 0
            && request.resource.data.insideCount >= 0
            && request.resource.data.insideCount <= request.resource.data.enteredCount
            && request.resource.data.maxCapacity >= 0
              && request.resource.data.enteredCount <= request.resource.data.maxCapacity + 1;
          allow update: if (
            (platformAdmin()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['maxCapacity', 'enteredCount', 'insideCount', 'status', 'lastEntryAt', 'lastMovementAt', 'extraGuest'])
              && request.resource.data.enteredCount is int
              && request.resource.data.insideCount is int
              && request.resource.data.insideCount >= 0
              && request.resource.data.insideCount <= request.resource.data.enteredCount
              && request.resource.data.maxCapacity is int
              && request.resource.data.enteredCount >= 0
              && request.resource.data.maxCapacity >= 0
              && request.resource.data.maxCapacity <= 50
              && request.resource.data.enteredCount <= request.resource.data.maxCapacity + 1)
            || (isAdmin()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['rut', 'name', 'rawName', 'course', 'maxCapacity', 'disabled', 'deleted', 'deletedAt', 'familyId', 'familyOwnerId', 'enteredCount', 'insideCount', 'status', 'lastEntryAt', 'lastMovementAt', 'extraGuest'])
              && request.resource.data.maxCapacity is int
              && request.resource.data.maxCapacity >= 0
              && request.resource.data.maxCapacity <= 50)
            || (
              eventWillBeOpen()
              && canOperate()
              && !('familyId' in resource.data)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['enteredCount', 'insideCount', 'status', 'lastEntryAt', 'lastMovementAt', 'extraGuest'])
              && request.resource.data.enteredCount is int
              && request.resource.data.insideCount is int
              && request.resource.data.insideCount >= 0
              && request.resource.data.insideCount <= request.resource.data.enteredCount
              && (!('disabled' in resource.data) || resource.data.disabled == false || 'familyId' in resource.data)
              && (!('deleted' in resource.data) || resource.data.deleted == false)
              && (
                (request.resource.data.enteredCount >= resource.data.enteredCount
                  && request.resource.data.enteredCount <= resource.data.maxCapacity
                  && (!('insideCount' in resource.data) || request.resource.data.insideCount >= resource.data.insideCount))
                || (request.resource.data.enteredCount == resource.data.enteredCount
                  && request.resource.data.insideCount < resource.data.insideCount)
                || (resource.data.enteredCount == resource.data.maxCapacity + 1
                  && request.resource.data.enteredCount == resource.data.enteredCount
                  && request.resource.data.insideCount > resource.data.insideCount
                  && resource.data.extraGuest is map)
                || (
                  resource.data.maxCapacity > 0
                  && resource.data.enteredCount == resource.data.maxCapacity
                  && !('extraGuest' in resource.data)
                  && request.resource.data.enteredCount == resource.data.maxCapacity + 1
                  && request.resource.data.status == 'CUPO_EXTRA'
                  && request.resource.data.extraGuest is map
                  && request.resource.data.extraGuest.keys().hasOnly(['name', 'relationship', 'addedAt', 'doorName'])
                  && request.resource.data.extraGuest.name is string
                  && request.resource.data.extraGuest.name.size() >= 2
                  && request.resource.data.extraGuest.name.size() <= 80
                  && request.resource.data.extraGuest.relationship is string
                  && request.resource.data.extraGuest.relationship.size() >= 2
                  && request.resource.data.extraGuest.relationship.size() <= 40
                )
                || (isAdmin()
                  && request.resource.data.enteredCount == 0
                  && request.resource.data.status == 'PENDIENTE'
                  && !('lastEntryAt' in request.resource.data)
                  && !('extraGuest' in request.resource.data))
                || (isAdmin()
                  && request.resource.data.enteredCount >= 0
                  && request.resource.data.enteredCount < resource.data.enteredCount
                  && request.resource.data.enteredCount >= resource.data.enteredCount - 5)
              )
            )
          );
          allow delete: if false;
        }

        match /doorSessions/{sessionId} {
          allow read: if isMember();
          allow create, update: if canOperate()
            && request.resource.data.deviceId == sessionId
            && request.resource.data.operatorUid == request.auth.uid
            && request.resource.data.operatorEmail == request.auth.token.email;
          allow delete: if isAdmin();
        }

        match /familyHistory/{historyId} {
          allow read: if isMember();
          allow create: if isAdmin()
            && request.resource.data.action in ['MERGE', 'SPLIT'];
          allow update, delete: if false;
        }

        match /logs/{logId} {
          allow read: if isMember();
          allow create: if (isAdmin() && eventWillBeOpen()) || (
            eventWillBeOpen()
              && request.resource.data.operatorUid == request.auth.uid
              && request.resource.data.operatorEmail == request.auth.token.email
              && ((('familyId' in request.resource.data) && (
                get(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)/students/$(request.resource.data.studentId)).data.familyId == request.resource.data.familyId
                && get(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)/students/$(request.resource.data.studentId)).data.disabled != true
                && get(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)/students/$(request.resource.data.studentId)).data.deleted != true
                && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)/families/$(request.resource.data.familyId)).data.enteredCount == request.resource.data.accumulated
                && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)/families/$(request.resource.data.familyId)).data.insideCount == request.resource.data.insideAfter
              )) || (!('familyId' in request.resource.data)
                && get(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)/students/$(request.resource.data.studentId)).data.disabled != true
                && get(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)/students/$(request.resource.data.studentId)).data.deleted != true
                && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)/students/$(request.resource.data.studentId)).data.enteredCount == request.resource.data.accumulated
                && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)/students/$(request.resource.data.studentId)).data.insideCount == request.resource.data.insideAfter
              ))
              && request.resource.data.count is int
              && request.resource.data.count >= 1
              && request.resource.data.count <= 5
              && (!('isExtra' in request.resource.data)
                || request.resource.data.isExtra == false
                || (request.resource.data.isExtra == true
                  && request.resource.data.count == 1
                  && request.resource.data.guestName is string
                  && request.resource.data.guestName.size() >= 2
                  && request.resource.data.guestName.size() <= 80
                  && request.resource.data.relationship is string
                  && request.resource.data.relationship.size() >= 2
                  && request.resource.data.relationship.size() <= 40))
          );
          allow update: if false;
          allow delete: if isAdmin() && eventWillBeOpen();
        }
      }
    }

    match /organizationInvitations/{invitationCode} {
      function validInvitation(data) {
        return data.keys().hasOnly([
            'code', 'organizationId', 'organizationName', 'email', 'role', 'status',
            'createdAt', 'expiresAt', 'usedAt', 'usedBy'
          ])
          && data.code == invitationCode
          && data.organizationId is string
          && data.organizationName is string
          && data.email is string
          && data.role in ['admin', 'operator', 'viewer']
          && data.status in ['active', 'used', 'cancelled']
          && data.expiresAt is timestamp;
      }

      allow list: if false;
      allow get: if signedIn() && (
        organizationAdmin(resource.data.organizationId)
        || (resource.data.status == 'active'
          && resource.data.expiresAt > request.time
          && resource.data.email == request.auth.token.email)
      );
      allow create: if validInvitation(request.resource.data)
        && request.resource.data.status == 'active'
        && organizationAdmin(request.resource.data.organizationId);
      allow update: if validInvitation(request.resource.data) && (
        organizationAdmin(resource.data.organizationId)
        || (signedIn()
          && resource.data.status == 'active'
          && resource.data.expiresAt > request.time
          && resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt', 'usedBy'])
          && request.resource.data.status == 'used'
          && request.resource.data.usedBy == request.auth.uid)
      );
      allow delete: if false;
    }

    // Compatibilidad de migración: solo administradores autenticados de la
    // organización reservada de Mundo Palabra pueden leer la estructura 1.2.
    match /events/{eventId} {
      allow read: if organizationAdmin('colegio-mundopalabra');
      allow write: if false;

      match /{legacyDocument=**} {
        allow read: if organizationAdmin('colegio-mundopalabra');
        allow write: if false;
      }
    }
  }
}
