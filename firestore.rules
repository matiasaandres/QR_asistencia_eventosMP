rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function platformAdmin() {
      return signedIn()
        && (
          request.auth.token.get('platformAdmin', false) == true
          || request.auth.token.get('role', '') == 'master_admin'
          // Compatibilidad temporal hasta asignar Custom Claims a la cuenta maestra.
          || request.auth.token.get('email', '') == 'matias.andres.mh@gmail.com'
        );
    }

    function organizationAdmin(organizationId) {
      return platformAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role == 'admin');
    }

    match /organizations/{organizationId} {
      function organizationActive() {
        return exists(/databases/$(database)/documents/organizations/$(organizationId))
          && get(/databases/$(database)/documents/organizations/$(organizationId)).data.status == 'active';
      }

      function isMember() {
        return platformAdmin() || (signedIn()
          && organizationActive()
          && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.status == 'active');
      }

      function roleIs(role) {
        return isMember()
          && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role == role;
      }

      function isAdmin() {
        return platformAdmin() || roleIs('admin');
      }

      function canOperate() {
        return isAdmin() || roleIs('operator');
      }

      function validOrganization(data) {
        return data.keys().hasOnly([
            'id', 'slug', 'name', 'ownerUid', 'memberUids', 'plan', 'status',
            'createdAt', 'updatedAt', 'logoUrl', 'primaryColor', 'contactEmail'
          ])
          && data.id == organizationId
          && data.slug == organizationId
          && data.name is string
          && data.name.size() >= 2
          && data.name.size() <= 100
          && data.logoUrl is string
          && data.logoUrl.size() <= 700000
          && data.primaryColor is string
          && data.primaryColor.matches('^#[0-9A-Fa-f]{6}$')
          && data.ownerUid is string
          && data.memberUids is list
          && data.memberUids.size() >= 1
          && data.memberUids.size() <= 100
          && data.ownerUid in data.memberUids
          && (!('contactEmail' in data) || data.contactEmail is string)
          && data.plan in ['pilot', 'event', 'monthly', 'annual']
          && data.status in ['active', 'suspended'];
      }

      allow list, get: if platformAdmin() || (signedIn() && request.auth.uid in resource.data.memberUids);
      allow create: if platformAdmin()
        && validOrganization(request.resource.data)
        && request.resource.data.memberUids.size() == 1;
      allow update: if validOrganization(request.resource.data) && (
        (platformAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'contactEmail', 'plan', 'status', 'logoUrl', 'primaryColor', 'ownerUid', 'memberUids', 'updatedAt']))
        ||
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'logoUrl', 'primaryColor', 'memberUids', 'updatedAt']))
        || (signedIn()
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
          && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.invitationCode is string
          && get(/databases/$(database)/documents/organizationInvitations/$(getAfter(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.invitationCode)).data.organizationId == organizationId
          && get(/databases/$(database)/documents/organizationInvitations/$(getAfter(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.invitationCode)).data.email == request.auth.token.email)
      );
      allow delete: if false;

      match /members/{userId} {
        function validMember(data) {
          return data.keys().hasOnly([
              'userId', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt',
              'invitationCode'
            ])
            && data.userId == userId
            && data.email is string
            && data.role in ['admin', 'operator', 'viewer']
            && data.status in ['active', 'disabled'];
        }

        allow read: if isMember();
        allow create: if validMember(request.resource.data) && (
          platformAdmin()
          ||
          isAdmin()
          || (
            signedIn()
            && userId == request.auth.uid
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)).data.ownerUid == request.auth.uid
          )
          || (
            signedIn()
            && userId == request.auth.uid
            && request.resource.data.invitationCode is string
            && get(/databases/$(database)/documents/organizationInvitations/$(request.resource.data.invitationCode)).data.organizationId == organizationId
            && get(/databases/$(database)/documents/organizationInvitations/$(request.resource.data.invitationCode)).data.email == request.auth.token.email
            && get(/databases/$(database)/documents/organizationInvitations/$(request.resource.data.invitationCode)).data.role == request.resource.data.role
            && get(/databases/$(database)/documents/organizationInvitations/$(request.resource.data.invitationCode)).data.status == 'active'
            && get(/databases/$(database)/documents/organizationInvitations/$(request.resource.data.invitationCode)).data.expiresAt > request.time
          )
        );
        allow update: if (platformAdmin() || isAdmin())
          && validMember(request.resource.data)
          && (userId != request.auth.uid || (request.resource.data.role == 'admin' && request.resource.data.status == 'active'))
          && (userId != get(/databases/$(database)/documents/organizations/$(organizationId)).data.ownerUid
            || (request.resource.data.role == 'admin' && request.resource.data.status == 'active'));
        allow delete: if (platformAdmin() || isAdmin())
          && userId != request.auth.uid
          && userId != get(/databases/$(database)/documents/organizations/$(organizationId)).data.ownerUid;
      }

      match /venues/{venueId} {
        function validVenue(data) {
          return data.keys().hasOnly([
              'id', 'name', 'description', 'templateKey', 'floors', 'seatCount', 'createdAt', 'updatedAt'
            ])
            && data.id == venueId
            && data.name is string
            && data.name.size() >= 2
            && data.name.size() <= 120
            && data.description is string
            && data.description.size() <= 300
            && data.templateKey is string
            && data.floors is list
            && data.floors.size() >= 1
            && data.floors.size() <= 10
            && data.seatCount is int
            && data.seatCount >= 1
            && data.seatCount <= 1000;
        }

        allow read: if isMember();
        allow create, update: if isAdmin() && validVenue(request.resource.data);
        allow delete: if false;
      }

      match /events/{eventId} {
        function validEvent(data) {
          return data.keys().hasOnly([
              'id', 'name', 'institution', 'date', 'defaultCapacity', 'doors',
              'status', 'startsAt', 'endsAt', 'startsAtTimestamp', 'endsAtTimestamp',
              'archived', 'studentsInitialized', 'initializedAt', 'createdAt', 'updatedAt',
              'maintenanceState', 'maintenanceOperation', 'maintenanceStartedAt', 'maintenanceCompletedAt'
            ])
            && data.id == eventId
            && data.name is string
            && data.name.size() >= 2
            && data.name.size() <= 120
            && data.institution is string
            && data.date is string
            && data.defaultCapacity is int
            && data.defaultCapacity >= 1
            && data.defaultCapacity <= 50
            && data.doors is list
            && data.doors.size() >= 1
            && data.doors.size() <= 20
            && data.status in ['draft', 'open', 'paused', 'closed']
            && data.startsAt is string
            && data.endsAt is string
            && (data.startsAt == '' || (data.startsAtTimestamp is timestamp))
            && (data.endsAt == '' || (data.endsAtTimestamp is timestamp))
            && (!('maintenanceState' in data) || data.maintenanceState in ['', 'running', 'failed'])
            && data.archived is bool
            && data.studentsInitialized == true;
        }

        function eventWillBeOpen() {
          let event = getAfter(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)).data;
          return canOperate()
            && existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId))
            && event.archived == false
            && (!('maintenanceState' in event) || event.maintenanceState == '')
            && (!('status' in event) || event.status == 'open')
            && (event.startsAt == '' || request.time >= event.startsAtTimestamp)
            && (event.endsAt == '' || request.time < event.endsAtTimestamp);
        }

        function adminMaintenance(operation) {
          return isAdmin()
            && existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId))
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)).data.maintenanceState == 'running'
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)).data.maintenanceOperation == operation;
        }

        allow read: if isMember();
        allow create: if isAdmin() && validEvent(request.resource.data);
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'institution', 'date', 'defaultCapacity', 'doors', 'archived',
              'status', 'startsAt', 'endsAt', 'startsAtTimestamp', 'endsAtTimestamp',
              'studentsInitialized', 'initializedAt', 'createdAt', 'updatedAt',
              'maintenanceState', 'maintenanceOperation', 'maintenanceStartedAt', 'maintenanceCompletedAt'
            ])
          && validEvent(request.resource.data);
        allow delete: if false;

        match /seatPlans/{seatPlanId} {
          function validSeatPlan(data) {
            return data.keys().hasOnly([
                'id', 'eventId', 'venueId', 'venueName', 'assignments', 'updatedAt'
              ])
              && seatPlanId == 'current'
              && data.id == seatPlanId
              && data.eventId == eventId
              && data.venueId is string
              && data.venueName is string
              && data.venueName.size() <= 120
              && data.assignments is map
              && data.assignments.size() <= 2000;
          }

          allow read: if isMember();
          allow create, update: if isAdmin() && validSeatPlan(request.resource.data);
          allow delete: if false;
        }

        match /analytics/{analyticsId} {
          function validMetric(data) {
            return data.keys().hasOnly(['kind', 'key', 'label', 'people', 'entries', 'exits', 'reentries', 'movements', 'records', 'lastLogId', 'updatedAt'])
              && data.kind in ['door', 'hour']
              && data.key is string
              && data.key.size() >= 1
              && data.key.size() <= 120
              && data.label is string
              && data.label.size() >= 1
              && data.label.size() <= 120
              && data.people is int
              && data.people >= 0
              && data.entries is int
              && data.entries >= 0
              && data.exits is int
              && data.exits >= 0
              && data.reentries is int
              && data.reentries >= 0
              && data.movements is int
              && data.movements >= 0
              && (!('lastLogId' in data) || data.lastLogId is string)
              && data.records is int
              && data.records >= 0;
          }

          function validMeta(data) {
            return analyticsId == 'meta'
              && data.keys().hasOnly(['version', 'sourceLogCount', 'lastLogId', 'rebuiltAt'])
              && data.version is int
              && data.sourceLogCount is int
              && data.sourceLogCount >= 0
              && data.lastLogId is string
              && data.rebuiltAt is string;
          }

          allow read: if isMember();
          // Aggregate documents are privileged materialized views. Operators
          // write only the immutable log and capacity transition; an admin
          // rebuilds aggregates from that authoritative history.
          allow create, update: if isAdmin() && (
            (analyticsId != 'meta' && validMetric(request.resource.data))
            || validMeta(request.resource.data)
          );
          allow delete: if isAdmin();
        }

        match /families/{familyId} {
          function validFamily(data) {
            return data.keys().hasOnly([
                'id', 'maxCapacity', 'enteredCount', 'status', 'members',
                'insideCount', 'lastEntryAt', 'lastMovementAt', 'extraGuest', 'lastLogId', 'createdAt', 'updatedAt'
              ])
              && data.id == familyId
              && data.maxCapacity is int
              && data.maxCapacity >= 1
              && data.maxCapacity <= 50
              && data.enteredCount is int
              && data.enteredCount >= 0
              && data.enteredCount <= data.maxCapacity + 1
              && data.insideCount is int
              && data.insideCount >= 0
              && data.insideCount <= data.enteredCount
              && data.status in ['PENDIENTE', 'PARCIAL', 'COMPLETO', 'CUPO_EXTRA']
              && data.members is list
              && data.members.size() >= 1
              && data.members.size() <= 100
              && (!('extraGuest' in data) || (
                data.extraGuest is map
                && data.extraGuest.keys().hasOnly(['name', 'relationship', 'addedAt', 'doorName'])
                && data.extraGuest.name is string
                && data.extraGuest.name.size() >= 2
                && data.extraGuest.name.size() <= 80
                && data.extraGuest.relationship is string
                && data.extraGuest.relationship.size() >= 2
                && data.extraGuest.relationship.size() <= 40
              ));
          }

          function validOperatorFamilyMovement() {
            let logId = request.resource.data.get('lastLogId', '');
            let logPath = /databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)/logs/$(logId);
            let log = getAfter(logPath).data;
            return eventWillBeOpen()
              && logId is string
              && existsAfter(logPath)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'enteredCount', 'insideCount', 'status', 'lastEntryAt', 'lastMovementAt', 'extraGuest', 'lastLogId'
              ])
              && log.familyId == familyId
              && log.operatorUid == request.auth.uid
              && log.operatorEmail == request.auth.token.email
              && log.accumulated == request.resource.data.enteredCount
              && log.insideAfter == request.resource.data.insideCount
              && log.count is int
              && log.count >= 1
              && log.count <= 5
              && log.movementType in ['ENTRY', 'EXIT', 'REENTRY']
              && log.newAdmissions is int
              && log.reentries is int
              && (
                (log.movementType == 'EXIT'
                  && log.newAdmissions == 0
                  && log.reentries == 0
                  && request.resource.data.enteredCount == resource.data.enteredCount
                  && request.resource.data.insideCount == resource.data.insideCount - log.count)
                || (log.movementType in ['ENTRY', 'REENTRY']
                  && log.newAdmissions >= 0
                  && log.newAdmissions <= log.count
                  && log.reentries == log.count - log.newAdmissions
                  && request.resource.data.enteredCount == resource.data.enteredCount + log.newAdmissions
                  && request.resource.data.insideCount == resource.data.insideCount + log.count)
              );
          }

          allow read: if isMember();
          allow create: if isAdmin() && validFamily(request.resource.data);
          allow update: if validFamily(request.resource.data) && (
            isAdmin()
            || validOperatorFamilyMovement()
          );
          allow delete: if isAdmin();
        }

        match /students/{studentId} {
          function validStudentCounters(data) {
            return data.enteredCount is int
              && data.insideCount is int
              && data.maxCapacity is int
              && data.enteredCount >= 0
              && data.insideCount >= 0
              && data.insideCount <= data.enteredCount
              && data.maxCapacity >= 0
              && data.maxCapacity <= 50
              && data.enteredCount <= data.maxCapacity + 1;
          }

          function validOperatorStudentMovement() {
            let logId = request.resource.data.get('lastLogId', '');
            let logPath = /databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)/logs/$(logId);
            let log = getAfter(logPath).data;
            return eventWillBeOpen()
              && !('familyId' in resource.data)
              && (!('disabled' in resource.data) || resource.data.disabled == false)
              && (!('deleted' in resource.data) || resource.data.deleted == false)
              && logId is string
              && existsAfter(logPath)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'enteredCount', 'insideCount', 'status', 'lastEntryAt', 'lastMovementAt', 'extraGuest', 'lastLogId'
              ])
              && log.studentId == studentId
              && !('familyId' in log)
              && log.operatorUid == request.auth.uid
              && log.operatorEmail == request.auth.token.email
              && log.accumulated == request.resource.data.enteredCount
              && log.insideAfter == request.resource.data.insideCount
              && log.count is int
              && log.count >= 1
              && log.count <= 5
              && log.movementType in ['ENTRY', 'EXIT', 'REENTRY']
              && log.newAdmissions is int
              && log.reentries is int
              && (
                (log.movementType == 'EXIT'
                  && log.newAdmissions == 0
                  && log.reentries == 0
                  && request.resource.data.enteredCount == resource.data.enteredCount
                  && request.resource.data.insideCount == resource.data.insideCount - log.count)
                || (log.movementType in ['ENTRY', 'REENTRY']
                  && log.newAdmissions >= 0
                  && log.newAdmissions <= log.count
                  && log.reentries == log.count - log.newAdmissions
                  && request.resource.data.enteredCount == resource.data.enteredCount + log.newAdmissions
                  && request.resource.data.insideCount == resource.data.insideCount + log.count)
              );
          }

          allow read: if isMember();
          allow create: if isAdmin() && validStudentCounters(request.resource.data);
          allow update: if (
            validOperatorStudentMovement()
            || (isAdmin()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['rut', 'name', 'rawName', 'course', 'maxCapacity', 'disabled', 'deleted', 'deletedAt', 'familyId', 'familyOwnerId', 'enteredCount', 'insideCount', 'status', 'lastEntryAt', 'lastMovementAt', 'extraGuest', 'lastLogId'])
              && validStudentCounters(request.resource.data))
          );
          allow delete: if false;
        }

        match /doorSessions/{sessionId} {
          allow read: if isMember();
          allow create, update: if canOperate()
            && request.resource.data.deviceId == sessionId
            && request.resource.data.operatorUid == request.auth.uid
            && request.resource.data.operatorEmail == request.auth.token.email;
          allow delete: if isAdmin();
        }

        match /familyHistory/{historyId} {
          allow read: if isMember();
          allow create: if isAdmin()
            && request.resource.data.action in ['MERGE', 'SPLIT'];
          allow update, delete: if false;
        }

        match /logs/{logId} {
          function validOperatorLog() {
            return request.resource.data.keys().hasOnly([
                'studentId', 'familyId', 'studentName', 'course', 'count', 'movementType',
                'newAdmissions', 'reentries', 'accumulated', 'insideAfter', 'maxCapacity',
                'doorName', 'timestamp', 'formattedTime', 'formattedDate', 'operatorUid',
                'operatorEmail', 'isExtra', 'guestName', 'relationship'
              ])
              && request.resource.data.studentId is string
              && request.resource.data.studentName is string
              && request.resource.data.course is string
              && request.resource.data.count is int
              && request.resource.data.count >= 1
              && request.resource.data.count <= 5
              && request.resource.data.movementType in ['ENTRY', 'EXIT', 'REENTRY']
              && request.resource.data.newAdmissions is int
              && request.resource.data.newAdmissions >= 0
              && request.resource.data.newAdmissions <= request.resource.data.count
              && request.resource.data.reentries is int
              && request.resource.data.reentries == request.resource.data.count - request.resource.data.newAdmissions
              && request.resource.data.accumulated is int
              && request.resource.data.insideAfter is int
              && request.resource.data.timestamp is string
              && request.resource.data.doorName is string
              && request.resource.data.doorName.size() >= 1
              && request.resource.data.doorName.size() <= 120
              && request.resource.data.operatorUid == request.auth.uid
              && request.resource.data.operatorEmail == request.auth.token.email
              && (request.resource.data.movementType != 'EXIT' || request.resource.data.newAdmissions == 0)
              && (!request.resource.data.isExtra || (
                request.resource.data.count == 1
                && request.resource.data.newAdmissions == 1
                && request.resource.data.guestName is string
                && request.resource.data.guestName.size() >= 2
                && request.resource.data.guestName.size() <= 80
                && request.resource.data.relationship is string
                && request.resource.data.relationship.size() >= 2
                && request.resource.data.relationship.size() <= 40
              ));
          }

          function logIsLinkedToCapacityUpdate() {
            let student = get(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)/students/$(request.resource.data.studentId)).data;
            let studentAfter = getAfter(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)/students/$(request.resource.data.studentId)).data;
            return (!('disabled' in student) || student.disabled == false)
              && (!('deleted' in student) || student.deleted == false)
              && ((('familyId' in request.resource.data)
                  && ('familyId' in student)
                  && student.familyId == request.resource.data.familyId
                  && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/events/$(eventId)/families/$(request.resource.data.familyId)).data.get('lastLogId', '') == logId)
                || (!('familyId' in request.resource.data)
                  && studentAfter.get('lastLogId', '') == logId));
          }

          allow read: if isMember();
          allow create: if (eventWillBeOpen() && validOperatorLog() && logIsLinkedToCapacityUpdate())
            || (adminMaintenance('restore') && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 5);
          allow update: if false;
          allow delete: if isAdmin();
        }
      }
    }

    match /organizationInvitations/{invitationCode} {
      function validInvitation(data) {
        return data.keys().hasOnly([
            'code', 'organizationId', 'organizationName', 'email', 'role', 'status',
            'createdAt', 'expiresAt', 'usedAt', 'usedBy'
          ])
          && data.code == invitationCode
          && data.organizationId is string
          && data.organizationName is string
          && data.email is string
          && data.role in ['admin', 'operator', 'viewer']
          && data.status in ['active', 'used', 'cancelled']
          && data.expiresAt is timestamp;
      }

      allow list: if false;
      allow get: if signedIn() && (
        organizationAdmin(resource.data.organizationId)
        || (resource.data.status == 'active'
          && resource.data.expiresAt > request.time
          && resource.data.email == request.auth.token.email)
      );
      allow create: if validInvitation(request.resource.data)
        && request.resource.data.status == 'active'
        && organizationAdmin(request.resource.data.organizationId);
      allow update: if validInvitation(request.resource.data) && (
        organizationAdmin(resource.data.organizationId)
        || (signedIn()
          && resource.data.status == 'active'
          && resource.data.expiresAt > request.time
          && resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt', 'usedBy'])
          && request.resource.data.status == 'used'
          && request.resource.data.usedBy == request.auth.uid)
      );
      allow delete: if false;
    }

    // Compatibilidad de migración: solo administradores autenticados de la
    // organización reservada de Mundo Palabra pueden leer la estructura 1.2.
    match /events/{eventId} {
      allow read: if organizationAdmin('colegio-mundopalabra');
      allow write: if false;

      match /{legacyDocument=**} {
        allow read: if organizationAdmin('colegio-mundopalabra');
        allow write: if false;
      }
    }
  }
}
