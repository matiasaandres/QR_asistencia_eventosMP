{
  "name": "mundopalabra-acceso",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "npx --yes firebase-tools@15.30.0 emulators:exec --only firestore --project demo-mundopalabra-rules \"node --test tests/firestoreRules.integration.test.mjs\"",
    "audit": "node --test tests/*.test.mjs && vite build",
    "audit:full": "npm run test && npm run test:rules && npm run build",
    "generate:import-template": "node scripts/generate-bulk-import-template.mjs",
    "generate:qr-zip": "node scripts/generate-full-qr-archive.mjs",
    "migrate:mundopalabra": "node scripts/migrate-legacy-mundopalabra.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "exceljs": "^4.4.0",
    "firebase": "^11.4.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
